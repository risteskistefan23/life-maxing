# Copy this file to .env for local development (or set these as environment
# variables in your hosting provider, e.g. Render, for production).

# Local dev: leave DATABASE_URL unset — server.js defaults to the local
# ../data/lifemax.db SQLite file automatically.

# Production (Turso): after creating a database with `turso db create`, run
# `turso db show <name> --url` and `turso db tokens create <name>` to get these:
# DATABASE_URL=libsql://your-db-name-yourorg.turso.io
# DATABASE_AUTH_TOKEN=your-token-here

# Port the Express server listens on (Render sets this automatically).
# PORT=3001
